    <formulas>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR({!myVariable_current.RecordTypeId} = &quot;01258000000ckbVAAQ&quot;, {!myVariable_current.RecordTypeId} = &quot;01258000000ckdLAAQ&quot;), !{!$User.BypassProcessBuilders__c})</expression>
