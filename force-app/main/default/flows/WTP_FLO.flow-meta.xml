    <formulas>
        <name>my_Rule_2</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
    $Record.RecordTypeId = &quot;01258000000ckbVAAQ&quot;,
    $Record.RecordTypeId = &quot;01258000000ckdLAAQ&quot;
  ),
  NOT($User.BypassProcessBuilders__c),
 ISPICKVAL($Record.Requester__r.Team__c, &quot;France&quot;)
