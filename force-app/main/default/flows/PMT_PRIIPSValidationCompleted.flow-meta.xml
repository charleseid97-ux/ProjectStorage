    <formulas>
        <name>CheckInvestPerf</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordType.DeveloperName} =&apos;DesignAndProposal&apos;,
    INCLUDES({!$Record.TECH_TeamValidation__c}, &quot;InvestmentPerf&quot;),
    NOT(INCLUDES($Record__Prior.TECH_TeamValidation__c, &quot;InvestmentPerf&quot;))

)</expression>
    </formulas>
    <formulas>
        <name>CheckLegal</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordType.DeveloperName} =&apos;DesignAndProposal&apos;,
    INCLUDES({!$Record.TECH_TeamValidation__c}, &quot;Legal&quot;),
    NOT(INCLUDES($Record__Prior.TECH_TeamValidation__c, &quot;Legal&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>CheckRisk</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.RecordType.DeveloperName} =&apos;Filing&apos;,
    INCLUDES({!$Record.TECH_TeamValidation__c}, &quot;Risk&quot;),
    NOT(INCLUDES($Record__Prior.TECH_TeamValidation__c, &quot;Risk&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>toCheckSCFinal</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!toCheckSC}, 2) = &quot;, &quot;,
    LEFT({!toCheckSC}, LEN({!toCheckSC}) - 2),
    {!toCheckSC}
)</expression>
    </formulas>
