    <assignments>
        <description>The document's values, passed as tokens: a template can't be rendered on ProjectDocuments__c (activities not enabled), so the message is rendered on the project.</description>
        <name>AddDocumentTokens</name>
        <label>Add Document Tokens</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageTokens</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{_DocumentName_}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageTokens</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{_DocumentAuthor_}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageTokens</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{_DocumentLink_}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageTokens</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{_DocumentNote_}</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GET_DOCUMENT.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GET_DOCUMENT.tech_user__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GET_DOCUMENT.tech_RecordLinkNotifyAllcheckbox__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CustomTeamsMessageValues</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GET_DOCUMENT.Note__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendTeamsMessage</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Notify_All</name>
        <label>Check Notify All</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_DOCUMENT.NotifyAllTeamOwners__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AddDocumentTokens</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Portfolio_Model_type</name>
        <label>Is Portfolio Model type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Portfolio Model</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_email_to_tax_team</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow allows users to share a document or meeting summary via Microsoft Teams directly from a PMT project.
If the user selects the “Notify All” checkbox, the content will be sent to all Team Owners associated with the project via Teams notification.
If the checkbox is not selected, the message is sent only to the team(s) explicitly selected.
Teams message: Custom Teams Message PMTDocumentNotifyAllOwners, recipients = the PMT team owners of the project (Custom Email Recipient PMTDocumentNotifyAllOwners1, Apex Resolver PMTTeamOwnerRecipients); ESG only for SFDR 6, 8 or 9 (PMTTeam__mdt Notification Condition).</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailRecipientsPtfModel</name>
        <dataType>String</dataType>
        <expression>&apos;operationalexcellence.technology@carmignac.com&apos;&amp;&apos;,&apos;&amp;&apos;tax.generalsecretary@carmignac.com&apos;&amp;&apos;,&apos;&amp;&apos;middleofficefunds2@carmignac.com&apos;</expression>
    </formulas>
    <formulas>
        <name>ProjectLink</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Partner_Server_URL_520, FIND(&quot;/services&quot;, $Api.Partner_Server_URL_520)) &amp; &quot;/lightning/r/ProjectProduct__c/&quot; &amp; {!$Record.Project_product__c} &amp; &quot;/view&quot;</expression>
    </formulas>
    <interviewLabel>PMT_Teams Send Message - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMT - Teams Notification - CheckboxNotifyAll</label>
