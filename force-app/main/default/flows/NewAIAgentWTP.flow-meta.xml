    <description>Creates an AI Agent Governance WTP request. It can be launched from a WTP for a new agent or change request, or directly from an existing AI Agent to request a modification</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaSubject</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY())) &amp; &quot;-&quot; &amp;
RIGHT(&quot;0&quot; &amp; TEXT(MONTH(TODAY())), 2) &amp; &quot;-&quot; &amp;
RIGHT(&quot;0&quot; &amp; TEXT(DAY(TODAY())), 2) &amp;
IF(
    ISPICKVAL({!myRequest.AI_Agent_Request_Type__c}, &quot;Agent Modification&quot;),
    &quot; - Change - &quot;,
    &quot; - &quot;
) &amp;
{!myRequest.AgentName__c}</expression>
    </formulas>
    <formulas>
        <name>isAgent</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!recordId}, &quot;a4F&quot;)</expression>
    </formulas>
