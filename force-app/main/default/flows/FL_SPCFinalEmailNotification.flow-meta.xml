    <decisions>
        <name>Check_if_Creation_or_Modification</name>
        <label>Check if Creation or Modification</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>SendSPCFinalEmailCreation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Creation</defaultConnectorLabel>
        <rules>
            <name>Modification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Project_product__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>recordTypeName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendSPCFinalEmailModification</targetReference>
            </connector>
            <label>Modification</label>
        </rules>
    </decisions>
    <decisions>
        <name>check_if_SPC_Final_or_Go_Live</name>
        <label>check if SPC Final or Launch Date</label>
        <locationX>512</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SPC_Final</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SPC Final</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_Creation_or_Modification</targetReference>
            </connector>
            <label>SPC Final</label>
        </rules>
        <rules>
            <name>Go_Live</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Launch Date</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendLaunchDateNotification</targetReference>
            </connector>
            <label>Launch Date</label>
        </rules>
    </decisions>
    <description>This Record-Triggered Flow is used within the Product Management Tool (PMT) to automatically notify all distribution lists when a key milestone is reached.
It sends an email notification when a Milestone record is completed with either:
- SPC Final 
- Go Live

For SPC Final, the flow distinguishes between Creation and Modification types to send a tailored message.
For Go Live, a single standard notification is sent.
ESG (responsible.investment@carmignac.com) is included only if SFDR Category = 6, 8 or 9</description>
    <environments>Default</environments>
    <formulas>
        <name>MilestoneStartDate</name>
        <dataType>String</dataType>
