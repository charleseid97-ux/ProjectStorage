<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SendTeamsMessage</name>
        <label>Send Teams Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CustomTeamsMessageFlowAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>teamsMessageName</name>
            <value>
                <stringValue>PMTLaunchDateChange</stringValue>
            </value>
        </inputParameters>
        <nameSegment>CustomTeamsMessageFlowAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow sends a Teams message to all Team Owners whenever the Launch Date of an active PMT project is modified (Custom Teams Message PMTLaunchDateChange).
The objective is to ensure that all stakeholders are informed of any changes that may impact planning, coordination, or go-to-market activities.
Recipients: the PMT team owners of the project (Custom Email Recipient PMTLaunchDateChange1, Apex Resolver PMTTeamOwnerRecipients). A team without owner is not notified; ESG only for SFDR 6, 8 or 9 (PMTTeam__mdt Notification Condition).</description>
    <environments>Default</environments>
    <interviewLabel>PMT - Teams Notification - Launch Date Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMT - Teams Notification - Launch Date Change</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EndDate__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ProjectStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>ProjectProduct__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>SendTeamsMessage</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
