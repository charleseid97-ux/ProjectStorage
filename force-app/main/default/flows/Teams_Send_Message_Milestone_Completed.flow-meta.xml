<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SendTeamsMessage</name>
        <label>Send Teams Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CustomTeamsMessageFlowAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>teamsMessageName</name>
            <value>
                <stringValue>PMTMilestoneCompleted</stringValue>
            </value>
        </inputParameters>
        <nameSegment>CustomTeamsMessageFlowAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow sends a Teams message when a milestone is marked as Completed in the Product Management Tool (PMT).
All milestones trigger a notification except for “SPC Final” and “Launch Date”, which are handled by FL_SPCFinalEmailNotification.
Custom Teams Message PMTMilestoneCompleted; recipients: the PMT team owners of the project (Custom Email Recipient PMTMilestoneCompleted1, Apex Resolver PMTTeamOwnerRecipients). A team without owner is not notified; ESG only for SFDR 6, 8 or 9 (PMTTeam__mdt Notification Condition).</description>
    <environments>Default</environments>
    <interviewLabel>PMT - Teams Notification - Milestones Completed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMT - Teams Notification - Milestones Completed</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>SPC Final</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Launch Date</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Milestone__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>SendTeamsMessage</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
