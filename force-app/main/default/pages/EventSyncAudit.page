<apex:page controller="EventSyncAuditController" lightningStylesheets="true" docType="html-5.0" showHeader="true" sidebar="false">
    <style>
        .audit-shell{background:#f7f9fc;padding:20px;font-family:Arial,sans-serif;color:#16325c}.audit-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}.title{font-size:28px;font-weight:700;margin:0}.subtitle{color:#54698d;margin-top:5px}.filters{display:flex;gap:12px;align-items:flex-end}.filter label{display:block;font-weight:700;margin-bottom:5px}.filter input{border:1px solid #c9d3e1;border-radius:7px;padding:9px}.search-btn{background:#0176d3;color:white;border:0;border-radius:7px;padding:11px 18px;font-weight:700;cursor:pointer}.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:18px}.metric{padding:16px;border-radius:10px;font-weight:700}.metric b{font-size:28px;display:block}.m-total{background:#eaf4ff}.m-ok{background:#e7f8ed;color:#067d35}.m-warn{background:#fff4d8;color:#a15c00}.m-error{background:#fdeaea;color:#ba0517}.table-wrap{background:white;border:1px solid #e3e8ef;border-radius:12px;overflow:hidden}.audit-table{width:100%;border-collapse:collapse}.audit-table th{background:#f3f6fa;text-align:left;padding:12px;border-bottom:1px solid #d8dde6}.audit-table td{padding:12px;border-bottom:1px solid #e5e9f0;vertical-align:top}.sf-card{background:#eef7ff;border:1px solid #b9ddff;border-radius:9px;padding:12px;min-width:245px}.graph-card{background:#fff8df;border:1px solid #f3d47a;border-radius:9px;padding:12px;margin-bottom:7px;min-width:280px}.missing-card{border:1px dashed #e55b66;background:#fff4f5;color:#ba0517;border-radius:9px;padding:18px}.link-icon{font-size:25px;font-weight:700;display:inline-block;margin:10px}.link-ok{color:#04844b}.link-broken{color:#c23934}.status{display:inline-block;padding:7px 12px;border-radius:16px;font-weight:700}.status-ok{background:#d9f5e4;color:#067d35}.status-warning{background:#fff1c7;color:#8c4b02}.status-error{background:#fde3e5;color:#ba0517}.status-duplicate{background:#fde3e5;color:#ba0517}.muted{color:#706e6b;font-size:12px}.error{background:#fde3e5;color:#ba0517;padding:12px;border-radius:8px;margin-bottom:12px}.graph-id{font-family:monospace}.sf-link{color:#0176d3;text-decoration:underline}.empty-sf{border:1px dashed #8fc6f4;background:#f5faff;color:#5a8bb5;border-radius:9px;padding:20px;text-align:center}
    </style>
    <apex:form >
        <div class="audit-shell">
            <div class="audit-header">
                <div><div class="title">Event Sync Audit</div><div class="subtitle">Compare fully approved events between Salesforce (Event__c) and Graph.</div></div>
                <div class="filters">
                    <div class="filter"><label>Start Date</label><apex:input type="date" value="{!startDate}"/></div>
                    <div class="filter"><label>End Date</label><apex:input type="date" value="{!endDate}"/></div>
                    <apex:commandButton value="Search Events" action="{!searchEvents}" styleClass="search-btn"/>
                </div>
            </div>
            <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}"><div class="error">{!errorMessage}</div></apex:outputPanel>
            <div class="cards">
                <div class="metric m-total"><b>{!totalCount}</b>Total Events</div>
                <div class="metric m-ok"><b>{!syncedCount}</b>Synced</div>
                <div class="metric m-warn"><b>{!missingGraphCount}</b>Missing in Graph</div>
                <div class="metric m-warn"><b>{!missingSalesforceCount}</b>Missing in Salesforce</div>
                <div class="metric m-error"><b>{!duplicateGraphCount}</b>Duplicate in Graph</div>
            </div>
            <div class="table-wrap"><table class="audit-table"><thead><tr><th>Event Details</th><th>Event__c (Salesforce)</th><th>Link</th><th>Graph Event(s)</th><th>Status</th></tr></thead><tbody>
                <apex:repeat value="{!rows}" var="row"><tr>
                    <td><strong>{!IF(ISBLANK(row.salesforceName), row.graphEvents[0].subject, row.salesforceName)}</strong><br/><span class="muted">{!row.eventDate}</span><br/><span class="muted">{!row.type} {!row.salesTeam}</span></td>
                    <td><apex:outputPanel rendered="{!NOT(ISBLANK(row.salesforceId))}"><div class="sf-card"><strong>Event__c</strong><br/><apex:outputLink value="{!row.salesforceUrl}" styleClass="sf-link">{!row.salesforceId}</apex:outputLink><br/><span class="status status-ok">Fully Approved</span><br/><span class="muted">Stored Graph ID: {!row.salesforceGraphId}</span></div></apex:outputPanel><apex:outputPanel rendered="{!ISBLANK(row.salesforceId)}"><div class="empty-sf">No Event__c found</div></apex:outputPanel></td>
                    <td><apex:repeat value="{!row.graphEvents}" var="g"><div class="{!g.linkClass}"><apex:outputText value="{!g.linkSymbol}" escape="false"/></div></apex:repeat></td>
                    <td><apex:outputPanel rendered="{!row.graphEvents.size = 0}"><div class="missing-card">No Graph event found</div></apex:outputPanel><apex:repeat value="{!row.graphEvents}" var="g"><div class="graph-card"><strong>Graph Event</strong><br/><span class="graph-id">{!g.id}</span><br/>{!g.eventDate}<br/>{!g.subject}</div></apex:repeat></td>
                    <td><span class="{!row.statusClass}">{!row.status}</span></td>
                </tr></apex:repeat>
            </tbody></table></div>
        </div>
    </apex:form>
</apex:page>