<apex:page controller="EventSyncAuditController" lightningStylesheets="true" docType="html-5.0" showHeader="true" sidebar="true">
    <style>
        .audit-shell {
            background: #f7f9fb;
            padding: 24px;
            font-family: Arial, sans-serif;
            color: #181818;
        }

        .audit-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 20px;
        }

        .title {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }

        .subtitle {
            color: #5f6368;
            margin-top: 5px;
            font-size: 13px;
        }

        .filters {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 12px;
            color: #444;
        }

        .filter input {
            border: 1px solid #c9c9c9;
            border-radius: 4px;
            padding: 8px 10px;
            background: white;
            min-width: 150px;
        }

        .event-name-filter input {
            min-width: 240px;
        }

        .search-btn {
            background: #0176d3;
            color: white;
            border: 0;
            border-radius: 4px;
            padding: 9px 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-bottom: 18px;
        }
        .metric {
            background: white;
            border: 1px solid #d8dde6;
            border-radius: 6px;
            padding: 14px 16px;
            font-size: 13px;
            color: #444;
            text-align: left;
            cursor: pointer;
            width: 100%;
            transition: background 0.15s, border-color 0.15s;
        }

        .metric:hover {
            background: #f7f9fb;
        }

        .metric.active {
            background: #f3f6f9;
            border-color: #747474;
        }

        .metric-total {
            border-left: 4px solid #0176d3;
        }

        .metric-ok {
            border-left: 4px solid #2e844a;
        }

        .metric-warning {
            border-left: 4px solid #dd7a01;
        }

        .metric-error {
            border-left: 4px solid #ba0517;
        }

        .metric b {
            font-size: 24px;
            display: block;
            color: #181818;
            margin-bottom: 3px;
        }

        .table-wrap {
            background: white;
            border: 1px solid #d8dde6;
            border-radius: 6px;
            overflow: hidden;
        }

        .audit-table {
            width: 100%;
            border-collapse: collapse;
        }

        .audit-table th {
            background: #f3f3f3;
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #d8dde6;
            font-size: 12px;
            font-weight: 700;
            color: #444;
        }

        .audit-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #ecebea;
            vertical-align: top;
        }

        .event-card {
            border: 1px solid #d8dde6;
            border-radius: 5px;
            padding: 12px;
            background: #fff;
            min-width: 240px;
        }

        .external-card {
            border: 1px solid #d8dde6;
            border-radius: 5px;
            padding: 12px;
            background: #fafafa;
            margin-bottom: 7px;
            min-width: 260px;
        }

        .missing-card,
        .empty-event {
            border: 1px dashed #b0adab;
            background: #fafafa;
            color: #706e6b;
            border-radius: 5px;
            padding: 16px;
            text-align: center;
        }

        .link-icon {
            font-size: 20px;
            display: inline-block;
            margin: 8px;
        }

        .link-ok {
            color: #2e844a;
        }

        .link-broken {
            color: #ba0517;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            background: #f3f3f3;
            color: #444;
        }

        .status-ok {
            background: #eaf5ee;
            color: #2e844a;
        }

        .status-warning {
            background: #f7f3e8;
            color: #8c4b02;
        }

        .status-error,
        .status-duplicate {
            background: #f8e8e8;
            color: #ba0517;
        }

        .muted {
            color: #706e6b;
            font-size: 12px;
        }

        .error {
            background: #f8e8e8;
            color: #ba0517;
            padding: 12px;
            border-radius: 4px;
            margin-bottom: 12px;
            border: 1px solid #f1b4b8;
        }

        .sf-link {
            color: #0176d3;
            text-decoration: none;
        }

        .sf-link:hover {
            text-decoration: underline;
        }

        .technical-link {
            color: #0176d3;
            cursor: pointer;
            font-size: 12px;
            margin-top: 8px;
            display: inline-block;
            text-decoration: underline;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.35);
            align-items: center;
            justify-content: center;
        }

        .modal {
            background: white;
            width: 520px;
            max-width: 90%;
            border-radius: 6px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid #d8dde6;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
        }

        .modal-body {
            padding: 20px;
        }

        .modal-row {
            margin-bottom: 14px;
        }

        .modal-label {
            font-size: 11px;
            font-weight: 700;
            color: #706e6b;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .modal-value {
            word-break: break-all;
            font-family: monospace;
            font-size: 12px;
        }

        .close-modal {
            cursor: pointer;
            font-size: 20px;
            color: #706e6b;
        }
        .event-flags {
            display: flex;
            gap: 6px;
            margin-top: 8px;
        }

        .event-flag {
            width: 24px;
            height: 24px;
            border: 1px solid #c9c9c9;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f7f9fb;
            color: #444;
            font-size: 14px;
            cursor: help;
        }
                .resend-btn {
            margin-top: 10px;
            background: #0176d3;
            color: white;
            border: 0;
            border-radius: 4px;
            padding: 7px 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .resend-btn:disabled {
            background: #c9c9c9;
            color: #666;
            cursor: not-allowed;
        }

        .resend-result {
            margin-top: 8px;
            font-size: 12px;
            color: #444;
        }

        .find-bookly-btn,
        .link-bookly-btn {
            background: #0176d3;
            color: white;
            border: 0;
            border-radius: 4px;
            padding: 7px 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .bookly-modal {
            width: 850px;
            max-width: 95%;
        }

        .bookly-results {
            width: 100%;
            border-collapse: collapse;
        }

        .bookly-results th,
        .bookly-results td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #ecebea;
        }

        .bookly-results th {
            background: #f3f3f3;
            font-size: 12px;
        }

                .delete-microsoft-btn {
            margin-top: 10px;
            background: #ba0517;
            color: white;
            border: 0;
            border-radius: 4px;
            padding: 7px 12px;
            font-weight: 600;
            cursor: pointer;
        }


    </style>

    <script>
        // Filters displayed audit rows without executing another Salesforce or Microsoft request.
        function filterByStatus(selectedButton, status) {
            var rows = document.querySelectorAll('.audit-row');
            var buttons = document.querySelectorAll('.metric');

            buttons.forEach(function(button) {
                button.classList.remove('active');
            });

            selectedButton.classList.add('active');

            rows.forEach(function(row) {
                row.style.display =
                    !status || row.getAttribute('data-status') === status
                        ? ''
                        : 'none';
            });
        }

        function openTechnicalDetails(title, source, recordId, microsoftEventId, eventDate) {
            document.getElementById('technicalModalTitle').textContent = title;
            document.getElementById('technicalSource').textContent = source || '-';
            document.getElementById('technicalRecordId').textContent = recordId || '-';
            document.getElementById('technicalMicrosoftId').textContent = microsoftEventId || '-';
            document.getElementById('technicalDate').textContent = eventDate || '-';

            document.getElementById('technicalModal').style.display = 'flex';
        }

        function closeTechnicalDetails() {
            document.getElementById('technicalModal').style.display = 'none';
        }

        // Opens the Bookly Event matching popup.
        function openBooklyModal() {
            document.getElementById('booklyModal').style.display = 'flex';
        }

        // Closes the Bookly Event matching popup.
        function closeBooklyModal() {
            document.getElementById('booklyModal').style.display = 'none';
        }
    </script>

    <apex:form >
        <apex:actionFunction name="refreshAuditAfterLink"
            action="{!searchEvents}"
            reRender="auditResults"
        />
        <div class="audit-shell">

            <div class="audit-header">
                <div>
                    <div class="title">Event Synchronization Audit</div>
                    <div class="subtitle">
                        Check that fully approved events are correctly synchronized with Microsoft Calendar.
                    </div>
                </div>

                <div class="filters">
                    <div class="filter event-name-filter">
                        <label>Event Name</label>
                        <apex:inputText value="{!eventNameFilter}">
                            <apex:actionSupport event="onchange"
                                action="{!searchEvents}"
                                reRender="auditResults"
                            />
                        </apex:inputText>
                    </div>

                    <div class="filter">
                        <label>Start Date</label>
                        <apex:input type="date" value="{!startDate}"/>
                    </div>

                    <div class="filter">
                        <label>End Date</label>
                        <apex:input type="date" value="{!endDate}"/>
                    </div>

                    <apex:commandButton value="Search"
                        action="{!searchEvents}"
                        styleClass="search-btn"
                        reRender="auditResults"
                    />
                </div>
            </div>

            <apex:outputPanel id="auditResults">
                <apex:outputPanel id="resendResult">
                    <apex:outputPanel rendered="{!NOT(ISBLANK(resendMessage))}">
                        <div class="resend-result">
                            {!resendMessage}
                        </div>
                    </apex:outputPanel>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!NOT(ISBLANK(linkMessage))}">
                    <div class="resend-result">
                        {!linkMessage}
                    </div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}">
                    <div class="error">{!errorMessage}</div>
                </apex:outputPanel>

                <div class="cards">
                    <button type="button" class="metric metric-total active" onclick="filterByStatus(this, '')">
                        <b>{!totalCount}</b>
                        Total Events
                    </button>

                    <button type="button" class="metric metric-ok" onclick="filterByStatus(this, 'Synced')">
                        <b>{!syncedCount}</b>
                        Synchronized
                    </button>

                    <button type="button" class="metric metric-warning" onclick="filterByStatus(this, 'Missing in Graph')">
                        <b>{!missingGraphCount}</b>
                        Missing in Microsoft Calendar
                    </button>

                    <button type="button" class="metric metric-warning" onclick="filterByStatus(this, 'Missing in Salesforce')">
                        <b>{!missingSalesforceCount}</b>
                        Missing in Salesforce
                    </button>

                    <button type="button" class="metric metric-error" onclick="filterByStatus(this, 'Duplicate in Graph')">
                        <b>{!duplicateGraphCount}</b>
                        Duplicate in Microsoft Calendar
                    </button>
                </div>

                <div class="table-wrap">
                    <table class="audit-table">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Salesforce</th>
                                <th>Synchronization</th>
                                <th>Microsoft Calendar</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <apex:repeat value="{!rows}" var="row">
                                <tr class="audit-row" data-status="{!row.status}">

                                    <td>
                                        <strong>
                                            {!IF(
                                                ISBLANK(row.salesforceName),
                                                row.graphEvents[0].subject,
                                                row.salesforceName
                                            )}
                                        </strong>

                                        <br/>

                                        <span class="muted">
                                            {!row.eventDate}
                                        </span>

                                        <br/>

                                        <span class="muted">
                                            {!row.type} {!row.salesTeam}
                                        </span>
                                    </td>

                                    <td>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(row.salesforceId))}">
                                            <div class="event-card">

                                                <strong>Salesforce Event</strong>

                                                <br/>

                                                <apex:outputLink value="{!row.salesforceUrl}"
                                                    styleClass="sf-link"
                                                >
                                                    Open Event
                                                </apex:outputLink>

                                                <br/><br/>

                                                <span class="status {!IF(row.salesforceStatus = 'Cancelled', 'status-error', 'status-ok')}">
                                                    {!row.salesforceStatus}
                                                </span>

                                                <div class="event-flags">
                                                    <apex:outputPanel rendered="{!row.noAutomations}">
                                                        <span class="event-flag" title="Automations disabled">&#9881;</span>
                                                    </apex:outputPanel>

                                                    <apex:outputPanel rendered="{!row.legacy}">
                                                        <span class="event-flag" title="Legacy event">&#8635;</span>
                                                    </apex:outputPanel>
                                                </div>

                                                <span
                                                    class="technical-link"
                                                    onclick="openTechnicalDetails(
                                                        'Salesforce Event - Technical Details',
                                                        'Salesforce',
                                                        '{!row.salesforceId}',
                                                        '{!row.salesforceGraphId}',
                                                        '{!row.eventDate}'
                                                    )"
                                                >
                                                    Technical details
                                                </span>

                                                <br/>

                                                <apex:commandButton value="{!IF(ISBLANK(row.salesforceGraphId), 'Send invitation', 'Update invitation')}"
                                                    action="{!resendEvent}"
                                                    styleClass="resend-btn"
                                                    reRender="resendResult"
                                                    onclick="if (!confirm(this.value + ' - Are you sure?')) { return false; } this.disabled=true; this.value='Queued';"
                                                >
                                                    <apex:param name="resendEventId"
                                                        value="{!row.salesforceId}"
                                                        assignTo="{!resendEventId}"
                                                    />
                                                </apex:commandButton>

                                            </div>
                                        </apex:outputPanel>

                                        <apex:outputPanel rendered="{!ISBLANK(row.salesforceId)}">
                                            <div class="empty-event">
                                                No Salesforce Event found

                                                <br/><br/>

                                                <apex:commandButton value="Find in Bookly"
                                                    action="{!findInBookly}"
                                                    styleClass="find-bookly-btn"
                                                    reRender="booklyModalContent"
                                                    oncomplete="openBooklyModal();"
                                                >
                                                    <apex:param name="selectedMicrosoftEventId"
                                                        value="{!row.graphEvents[0].id}"
                                                        assignTo="{!selectedMicrosoftEventId}"
                                                    />
                                                    <apex:param name="selectedMicrosoftSubject"
                                                        value="{!row.graphEvents[0].subject}"
                                                        assignTo="{!selectedMicrosoftSubject}"
                                                    />
                                                    <apex:param name="selectedMicrosoftDate"
                                                        value="{!TEXT(row.graphEvents[0].eventDate)}"
                                                        assignTo="{!selectedMicrosoftDate}"
                                                    />
                                                </apex:commandButton>
                                            </div>
                                        </apex:outputPanel>
                                    </td>

                                    <td>
                                        <apex:repeat value="{!row.graphEvents}" var="g">
                                            <div class="{!g.linkClass}">
                                                <apex:outputText value="{!g.linkSymbol}"
                                                    escape="false"
                                                />
                                            </div>
                                        </apex:repeat>
                                    </td>

                                    <td>
                                        <apex:outputPanel rendered="{!row.graphEvents.size = 0}">
                                            <div class="missing-card">
                                                No Microsoft Calendar event found
                                            </div>
                                        </apex:outputPanel>

                                        <apex:repeat value="{!row.graphEvents}" var="g">
                                            <div class="external-card">

                                                <strong>Microsoft Calendar Event</strong>

                                                <br/>

                                                {!g.eventDate}

                                                <br/>

                                                {!g.subject}

                                                <br/>

                                                <span
                                                    class="technical-link"
                                                    onclick="openTechnicalDetails(
                                                        'Microsoft Calendar Event - Technical Details',
                                                        'Microsoft Calendar',
                                                        '',
                                                        '{!g.id}',
                                                        '{!g.eventDate}'
                                                    )"
                                                >
                                                    Technical details
                                                </span>

                                                <br/>

                                                <apex:commandButton value="Delete"
                                                    action="{!deleteMicrosoftEvent}"
                                                    styleClass="delete-microsoft-btn"
                                                    reRender="auditResults"
                                                    onclick="if (!confirm('Delete this Microsoft Calendar Event - Are you sure?')) { return false; }"
                                                >
                                                    <apex:param name="deleteMicrosoftEventId"
                                                        value="{!g.id}"
                                                        assignTo="{!selectedMicrosoftEventId}"
                                                    />
                                                </apex:commandButton>

                                            </div>
                                        </apex:repeat>
                                    </td>

                                    <td>
                                        <apex:outputPanel rendered="{!row.status = 'Synced'}">
                                            <span class="status status-ok">
                                                Synchronized
                                            </span>
                                        </apex:outputPanel>

                                        <apex:outputPanel rendered="{!row.status = 'Missing in Graph'}">
                                            <span class="status status-error">
                                                Missing in Microsoft Calendar
                                            </span>
                                        </apex:outputPanel>

                                        <apex:outputPanel rendered="{!row.status = 'Missing in Salesforce'}">
                                            <span class="status status-warning">
                                                Missing in Salesforce
                                            </span>
                                        </apex:outputPanel>

                                        <apex:outputPanel rendered="{!row.status = 'Duplicate in Graph'}">
                                            <span class="status status-duplicate">
                                                Duplicate in Microsoft Calendar
                                            </span>
                                        </apex:outputPanel>

                                        <apex:outputPanel rendered="{!row.status = 'ID mismatch'}">
                                            <span class="status status-error">
                                                Synchronization mismatch
                                            </span>
                                        </apex:outputPanel>
                                    </td>

                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                </div>

            </apex:outputPanel>
        </div>
                    <apex:outputPanel id="booklyModalContent">
                <div id="booklyModal" class="modal-overlay" onclick="closeBooklyModal()">
                    <div class="modal bookly-modal" onclick="event.stopPropagation()">

                        <div class="modal-header">
                            <span>Find Event in Bookly</span>
                            <span class="close-modal" onclick="closeBooklyModal()">&#215;</span>
                        </div>

                        <div class="modal-body">

                            <apex:outputPanel rendered="{!booklyCandidates.size = 0}">
                                <div class="empty-event">
                                    No matching Bookly Event found.
                                </div>
                            </apex:outputPanel>

                            <apex:outputPanel rendered="{!NOT(booklyCandidates.size = 0)}">
                                <table class="bookly-results">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Status</th>
                                            <th>Event</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <apex:repeat value="{!booklyCandidates}" var="candidate">
                                            <tr>
                                                <td>{!candidate.name}</td>

                                                <td>{!candidate.status}</td>

                                                <td>
                                                    <apex:outputLink value="{!candidate.eventUrl}"
                                                        target="_blank"
                                                        styleClass="sf-link"
                                                    >
                                                        Open Event
                                                    </apex:outputLink>
                                                </td>

                                                <td>
                                                    <apex:commandButton rendered="{!candidate.canLink}"
                                                        value="Link to this event"
                                                        action="{!linkBooklyEvent}"
                                                        styleClass="link-bookly-btn"
                                                        reRender="booklyModalContent"
                                                        oncomplete="closeBooklyModal(); refreshAuditAfterLink();"
                                                    >
                                                        <apex:param value="{!candidate.id}"
                                                            assignTo="{!selectedBooklyEventId}"
                                                        />
                                                    </apex:commandButton>

                                                    <apex:outputPanel rendered="{!NOT(candidate.canLink)}">
                                                        <span class="muted">
                                                            Already linked
                                                        </span>
                                                    </apex:outputPanel>
                                                </td>
                                            </tr>
                                        </apex:repeat>
                                    </tbody>
                                </table>
                            </apex:outputPanel>

                        </div>
                    </div>
                </div>
            </apex:outputPanel>
    </apex:form>

    <div id="technicalModal" class="modal-overlay" onclick="closeTechnicalDetails()">
        <div class="modal" onclick="event.stopPropagation()">

            <div class="modal-header">
                <span id="technicalModalTitle">Technical Details</span>
                <span class="close-modal" onclick="closeTechnicalDetails()">&#215;</span>
            </div>

            <div class="modal-body">

                <div class="modal-row">
                    <div class="modal-label">Source</div>
                    <div id="technicalSource" class="modal-value"></div>
                </div>

                <div class="modal-row">
                    <div class="modal-label">Salesforce Record Id</div>
                    <div id="technicalRecordId" class="modal-value"></div>
                </div>

                <div class="modal-row">
                    <div class="modal-label">Microsoft Event Id</div>
                    <div id="technicalMicrosoftId" class="modal-value"></div>
                </div>

                <div class="modal-row">
                    <div class="modal-label">Event Date</div>
                    <div id="technicalDate" class="modal-value"></div>
                </div>

            </div>
        </div>
    </div>
</apex:page>