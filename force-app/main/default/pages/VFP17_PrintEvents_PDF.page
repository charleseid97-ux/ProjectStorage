<apex:page controller="VFC17_PrintEvents"
           applyHtmlTag="false"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           renderAs="pdf">

  <html>
  <head>
    <style>
      @page { size: A4; margin: 12mm 10mm 12mm 10mm; }
      body { font-family: Arial, sans-serif; font-size: 10pt; color: #111; }

      .page { page-break-after: always; }
      .page:last-child { page-break-after: auto; }

      table.layout { width: 100%; border-collapse: collapse; table-layout: fixed; }
      td.col {
        width: 33.33%;
        vertical-align: top;
        border-right: 1px solid #BFBFBF;
        border-left: none;
        border-top: none;
        border-bottom: none;
        padding: 4mm;
      }
      td.col:first-child { border-left: 1px solid #BFBFBF; }

      .monthBanner { height: 96pt; border-radius: 6px; margin: 0 0 6px 0; border: 1px solid #D0D0D0; }
      .eventBlock { border:1px solid #D0D0D0; border-radius:6px; margin:0 0 6px 0; overflow:hidden; }
      .eventColorBar { height: 6pt; }

      .eventHeader { background:#F2F2F2; padding:6px 8px; font-weight:bold; border-bottom:1px solid #D9D9D9; }
      .eventHeaderTz { font-weight: normal; color: #666; }
      .conflictIcon {
        display: inline-block;
        width: 12pt; height: 12pt; line-height: 12pt;
        text-align: center;
        border-radius: 50%;
        border: 1px solid #C0392B;
        color: #C0392B;
        font-weight: bold;
        font-size: 9pt;
        margin-left: 6pt;
      }

      .eventBody { padding:6px 8px; }
      .title { font-weight:bold; line-height:12pt; height:36pt; overflow:hidden; }
      .speakers { font-style:italic; color:#444; line-height:12pt; height:24pt; overflow:hidden; margin-top:2px; }
      .separator { border-top:1px solid #E0E0E0; margin:6px 0; }
    </style>
  </head>

  <body>
    <apex:repeat value="{!pages}" var="p">
      <div class="page">
        <table class="layout">
          <tr>
            <apex:repeat value="{!p.columns}" var="col">
              <td class="col">
                <apex:repeat value="{!col.blocks}" var="b">

                  <apex:outputPanel rendered="{!b.isMonthBanner}">
                    <div class="monthBanner" style="background:{!b.monthColor};">
                      <div style="padding:10px; font-weight:bold; color:#fff;">{!b.monthLabel}</div>
                    </div>
                  </apex:outputPanel>

                  <apex:outputPanel rendered="{!NOT(b.isMonthBanner)}">
                    <div class="eventBlock">
                      <div class="eventColorBar" style="background:{!b.eventColor}"></div>

                      <div class="eventHeader">
                        {!b.dayLabel}

                        <apex:outputPanel rendered="{!NOT(ISBLANK(b.timeRangeLabel))}">
                          <span class="eventHeaderTz"> — {!b.timeRangeLabel}</span>
                        </apex:outputPanel>

                        <apex:outputPanel rendered="{!NOT(ISBLANK(b.displayTimezone))}">
                          <span class="eventHeaderTz"> ({!b.displayTimezone})</span>
                        </apex:outputPanel>

                        <apex:outputPanel rendered="{!b.isSpeakerConflict}">
                          <span class="conflictIcon">!</span>
                        </apex:outputPanel>
                      </div>

                      <div class="eventBody">
                        <div class="title">{!b.title}</div>
                        <div class="separator"></div>
                        <div class="speakers">{!b.speakersLabel}</div>
                      </div>
                    </div>
                  </apex:outputPanel>

                </apex:repeat>
              </td>
            </apex:repeat>
          </tr>
        </table>
      </div>
    </apex:repeat>
  </body>
  </html>
</apex:page>