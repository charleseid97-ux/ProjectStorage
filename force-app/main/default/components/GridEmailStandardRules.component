<apex:component controller="GridEmailStandardRulesController" access="global">
    <apex:attribute name="recordId" type="Id" description="The Grid__c record Id" assignTo="{!gridId}" />

    <apex:outputPanel rendered="{!hasGroups}">
        <apex:repeat value="{!groups}" var="grp">
            <div style="margin-bottom:14px;">
                <p style="margin:0 0 5px 0;font-size:13px;font-weight:700;color:#1b3a5c;">
                    {!grp.gridName}<span style="color:#718096;font-weight:400;"> ({!grp.productCount})</span>
                </p>
                <div>
                    <apex:repeat value="{!grp.products}" var="prod">
                        <span style="display:inline-block;background-color:#e2e8f0;color:#2d3748;font-size:11px;padding:2px 8px;border-radius:12px;margin:2px 3px 2px 0;">{!prod.shortName}</span>
                    </apex:repeat>
                </div>
                <apex:outputPanel rendered="{!grp.hasRules}">
                    <ul style="margin:5px 0 0 14px;padding:0;font-size:11px;color:#718096;line-height:1.6;">
                        <apex:repeat value="{!grp.rules}" var="rule">
                            <li>{!rule.text}</li>
                        </apex:repeat>
                    </ul>
                </apex:outputPanel>
            </div>
        </apex:repeat>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!NOT(hasGroups)}">
        <p style="color:#a0aec0;font-size:13px;font-style:italic;margin:0;">No products found.</p>
    </apex:outputPanel>
</apex:component>