<apex:component controller="GridEmailShareClassOverviewController" access="global">
    <apex:attribute name="recordId" type="Id" description="The Grid__c record Id" assignTo="{!gridId}" />

    <!-- ── Funds not included ── -->
    <p class="sco-title">Funds not included</p>
    <apex:outputPanel rendered="{!hasExcluded}">
        <div>
            <apex:repeat value="{!excluded}" var="fund">
                <span class="badge badge-red">{!fund}</span>
            </apex:repeat>
        </div>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!NOT(hasExcluded)}">
        <p class="sco-empty">None</p>
    </apex:outputPanel>

    <div class="sco-divider"></div>

    <!-- ── Restricted Share Classes ── -->
    <p class="sco-title">Restricted Share Classes</p>
    <apex:outputPanel rendered="{!hasRestricted}">
        <apex:repeat value="{!restricted}" var="grp">
            <div class="sco-group">
                <span class="sco-type">{!grp.shareType}</span>
                <span class="sco-dash">&mdash;</span>
                <apex:repeat value="{!grp.productShortNames}" var="name">
                    <span class="badge badge-amber">{!name}</span>
                </apex:repeat>
            </div>
        </apex:repeat>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!NOT(hasRestricted)}">
        <p class="sco-empty">None</p>
    </apex:outputPanel>

    <div class="sco-divider"></div>

    <!-- ── Unrestricted Share Classes ── -->
    <p class="sco-title">Unrestricted Share Classes <span class="sco-title-sub">(Added automatically)</span></p>
    <apex:outputPanel rendered="{!hasUnrestricted}">
        <apex:repeat value="{!filteredUnrestricted}" var="grp">
            <div class="sco-group">
                <span class="sco-type">{!grp.shareType}</span>
                <span class="sco-dash">&mdash;</span>
                <apex:outputPanel rendered="{!grp.isAllFunds}">
                    <span class="badge badge-green">All Funds</span>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(grp.isAllFunds)}">
                    <apex:repeat value="{!grp.products}" var="name">
                        <span class="badge badge-green">{!name}</span>
                    </apex:repeat>
                    <apex:repeat value="{!grp.missing}" var="name">
                        <span class="badge badge-red">{!name}</span>
                    </apex:repeat>
                </apex:outputPanel>
            </div>
        </apex:repeat>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!NOT(hasUnrestricted)}">
        <p class="sco-empty-last">None</p>
    </apex:outputPanel>
</apex:component>