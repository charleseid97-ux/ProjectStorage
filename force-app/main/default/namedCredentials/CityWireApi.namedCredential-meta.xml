<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>City Wire Api</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <externalCredential>CityWireApiCred</externalCredential>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://ratingsapi.citywireinsight.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>X-Api-Key</parameterName>
        <parameterType>CustomHeader</parameterType>
        <parameterValue>{!$Credential.CityWireApiCred.ApiKey}</parameterValue>
        <sensitive>true</sensitive>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>format</parameterName>
        <parameterType>CustomHeader</parameterType>
        <parameterValue>json</parameterValue>
        <sensitive>false</sensitive>
    </namedCredentialParameters>
</NamedCredential>
