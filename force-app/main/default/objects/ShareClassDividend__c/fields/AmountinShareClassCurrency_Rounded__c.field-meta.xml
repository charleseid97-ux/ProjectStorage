<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AmountinShareClassCurrency_Rounded__c</fullName>
    <description>Displays the dividend amount in Share Class currency, rounded down to 2 decimal places.</description>
    <externalId>false</externalId>
    <formula>FLOOR(DividendAmountScCcy__c * 100) / 100</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Amount in Share Class Currency (Rounded)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
