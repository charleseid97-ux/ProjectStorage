<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR47_RiskReturnScoreRRS</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(RiskReturnScoreRRS__c)),
OR(
RiskReturnScoreRRS__c &lt; 1,
RiskReturnScoreRRS__c &gt; 10
)
)</errorConditionFormula>
    <errorDisplayField>RiskReturnScoreRRS__c</errorDisplayField>
    <errorMessage>Risk Return Score (RRS) must be between 1 and 10.</errorMessage>
</ValidationRule>
