<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attendees_Invested_Rate__c</fullName>
    <formula>IF( Attended_Count__c &gt; 0
   ,  Attendees_Invested_Count__c / Attended_Count__c , null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Percentage of attendees present who are linked to client companies</inlineHelpText>
    <label>Attendees Invested Rate</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
