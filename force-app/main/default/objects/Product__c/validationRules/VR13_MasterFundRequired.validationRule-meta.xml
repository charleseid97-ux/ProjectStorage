<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR13_MasterFundRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				NOT($User.BypassValidationRules__c),
  ISPICKVAL( IsFeeder__c,&quot;True&quot;),
    ISBLANK(MasterFund__c)
)</errorConditionFormula>
    <errorDisplayField>MasterFund__c</errorDisplayField>
    <errorMessage>Master Fund is required when Is Feeder equal true</errorMessage>
</ValidationRule>
