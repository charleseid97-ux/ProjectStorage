<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agreement_Signature_Date_for_Signed</fullName>
    <active>true</active>
    <description>Signature date is mandatory when an Agreement is not in Negotiation</description>
    <errorConditionFormula>AND ( 
			!$User.BypassValidationRules__c,
   ISPICKVAL(Status__c, &apos;Signed&apos;),
   ISBLANK(SignedDate__c)
)</errorConditionFormula>
    <errorDisplayField>SignedDate__c</errorDisplayField>
    <errorMessage>A Signature Date is mandatory for this Status</errorMessage>
</ValidationRule>
