<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR15_DividendPolicyOEIC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($User.BypassValidationRules__c),
ISPICKVAL(Fund__r.LegalForm__c , &apos;OEIC&apos;),
ISPICKVAL(DividendPolicy__c ,&apos;Distributing&apos;)
)</errorConditionFormula>
    <errorDisplayField>DividendPolicy__c</errorDisplayField>
    <errorMessage>Only “Income” and “Accumulating” are applicable for OEIC Share Classes.</errorMessage>
</ValidationRule>
