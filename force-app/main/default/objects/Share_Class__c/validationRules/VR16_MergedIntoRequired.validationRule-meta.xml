<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR16_MergedIntoRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				NOT($User.BypassValidationRules__c),
				ISPICKVAL(Status__c, &quot;Closed - merged&quot;),
				ISBLANK(MergedInto__c)
)</errorConditionFormula>
    <errorDisplayField>MergedInto__c</errorDisplayField>
    <errorMessage>The “Merged Into” field is required when the share class is Closed - merged.</errorMessage>
</ValidationRule>
