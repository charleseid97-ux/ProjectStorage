<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR14_SRRIDate</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($User.BypassValidationRules__c),
NOT(ISBLANK(TEXT(SRRI__c))),
ISBLANK(SRRIDate__c)
)</errorConditionFormula>
    <errorDisplayField>SRRIDate__c</errorDisplayField>
    <errorMessage>The SRRI Date is required when SRRI is completed.</errorMessage>
</ValidationRule>
