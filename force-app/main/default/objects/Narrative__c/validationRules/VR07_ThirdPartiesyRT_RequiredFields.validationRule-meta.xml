<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR07_ThirdPartiesyRT_RequiredFields</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($User.BypassValidationRules__c),
RecordType.DeveloperName = &apos;ThirdParties&apos;,
OR(ISBLANK(TEXT(DomiciledIn__c)),
ISBLANK(LEICode__c)
)
)</errorConditionFormula>
    <errorMessage>For Third Parties, both the LEI Code and Domiciled In fields are required.</errorMessage>
</ValidationRule>
