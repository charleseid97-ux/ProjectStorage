<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR02_FormatISINCountryKey</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($User.BypassValidationRules__c),
NOT(
REGEX(
ISINCountryKey__c,
&quot;^[A-Z0-9]{12}_[A-Z]{2}$&quot;
)
)
)</errorConditionFormula>
    <errorDisplayField>ISINCountryKey__c</errorDisplayField>
    <errorMessage>ISINCountryKey must follow the format: &lt;12-character ISIN&gt;_&lt;2-letter ISO country code&gt; (e.g. FR0010148999_FR).</errorMessage>
</ValidationRule>
