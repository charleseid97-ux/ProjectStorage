<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SendAs__c</fullName>
    <description>The recipient list (To, Cc or Bcc) the rule's recipients are added to.</description>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <inlineHelpText>To, Cc or Bcc. An email left without any To recipient is sent to the No Recipient Addresses of the Email Service Settings (Custom Setting) instead.</inlineHelpText>
    <label>Send As</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>To</fullName>
                <default>true</default>
                <label>To</label>
            </value>
            <value>
                <fullName>Cc</fullName>
                <default>false</default>
                <label>Cc</label>
            </value>
            <value>
                <fullName>Bcc</fullName>
                <default>false</default>
                <label>Bcc</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
