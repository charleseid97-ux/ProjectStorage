<body style="height: auto; min-height: auto;">
<table border="0" cellpadding="0" cellspacing="0" role="presentation" style="font-family:Arial,Helvetica,sans-serif;background-color:#f3f6fa;padding:24px;" width="100%">
	
		<tr>
			<td align="center">
			<table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:620px;max-width:100%;background-color:#ffffff;border:1px solid #dce4ed;" width="620"><!-- TOP ACCENT -->
				
					<tr>
						<td style="background-color:#1c3553;height:10px;font-size:0;line-height:0;">&nbsp;</td>
					</tr>
					<!-- HEADER -->
					<tr>
						<td style="background-color:#1c3553;padding:20px 28px;">
						<div style="font-size:12px;letter-spacing:1px;color:#cbd8e6;font-weight:bold;">PRODUCT MANAGEMENT TOOL</div>

						<div style="font-size:22px;line-height:28px;color:#ffffff;font-weight:bold;padding-top:4px;">Milestone Completed</div>
						</td>
					</tr>
					<!-- INTRO -->
					<tr>
						<td style="padding:28px 28px 22px 28px;color:#242424;font-size:14px;line-height:22px;">✅ The PMT project called <strong>{{{Milestone__c.TECH_ProjectName__c}}}</strong> has completed the milestone <strong>{{{Milestone__c.Name}}}</strong>.</td>
					</tr>
					<!-- PROJECT LINK -->
					<tr>
						<td style="padding:4px 28px 24px 28px;">
						<table border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#edf3f8;border-left:4px solid #426b91;" width="100%">
							
								<tr>
									<td style="padding:18px 20px;color:#242424;font-size:14px;line-height:22px;">You can access this projet through <a href="{{{Milestone__c.TECH_ProjectLink__c}}}" rel="noopener noreferrer" style="color:#285b87;font-weight:bold;text-decoration:underline;" target="_blank"> this link </a></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<!-- FOOTER -->
					<tr>
						<td style="border-top:1px solid #dce4ed;padding:20px 28px 24px 28px;color:#526579;font-size:13px;line-height:21px;"><strong style="color:#1c3553;">The Product Strategy Team </strong></td>
					</tr>
				
			</table>
			</td>
		</tr>
	
</table>
