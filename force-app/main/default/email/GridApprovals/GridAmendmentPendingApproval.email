<messaging:emailTemplate subject="[{!relatedTo.Agreement__r.Name} ({!relatedTo.Agreement__r.Agreement_Code__c})] - Grid Approval Request"
    recipientType="User"
    relatedToType="Grid__c">

<messaging:htmlEmailBody>
<!DOCTYPE html>
<html>
<body style="margin:0;padding:0;background-color:#f0f4f8;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f0f4f8">
<tr><td align="center" style="padding:32px 16px;">

  <!-- 600px card container -->
  <table width="600" border="0" cellpadding="0" cellspacing="0">
  <tr><td>

    <!-- ───── HEADER ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#1b3a5c" style="border-radius:8px 8px 0 0;">
      <tr>
        <td style="padding:28px 32px;text-align:center;">
          <p style="margin:0 0 6px 0;color:#7fb3d3;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;">Action Required</p>
          <h1 style="margin:0;color:#ffffff;font-size:20px;font-weight:700;line-height:1.3;">Grid Amendment &mdash; Approval Request</h1>
        </td>
      </tr>
    </table>

    <!-- ───── INTRO ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
      <tr>
        <td style="padding:24px 32px 20px 32px;border-bottom:2px solid #e8edf3;">
          <p style="margin:0;font-size:14px;color:#4a5568;line-height:1.7;">
            Hello,<br/><br/>
            The following <strong>Grid Amendment</strong> has been submitted and is pending your approval.
            Please review the details carefully and take action at your earliest convenience.
          </p>
        </td>
      </tr>
    </table>

    <!-- ───── GRID DETAILS ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
      <tr>
        <td style="padding:24px 32px 0 32px;">
          <p style="margin:0 0 10px 0;font-size:11px;font-weight:700;color:#1b3a5c;text-transform:uppercase;letter-spacing:2px;">Grid Details</p>
          <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #dde3ec;border-radius:6px;overflow:hidden;">
            <tr bgcolor="#e8edf3">
              <td style="padding:10px 16px;font-size:11px;font-weight:700;color:#1b3a5c;text-transform:uppercase;letter-spacing:1px;width:38%;border-bottom:1px solid #dde3ec;">Field</td>
              <td style="padding:10px 16px;font-size:11px;font-weight:700;color:#1b3a5c;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid #dde3ec;">Value</td>
            </tr>
            <tr bgcolor="#ffffff">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Agreement Name</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;font-weight:600;border-bottom:1px solid #eef1f6;">{!relatedTo.Agreement__r.Name}</td>
            </tr>
            <tr bgcolor="#f7f9fc">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Company Name</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.Agreement__r.Company_Name__c}</td>
            </tr>
            <tr bgcolor="#ffffff">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Team</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.Agreement__r.Team__c}</td>
            </tr>
            <tr bgcolor="#f7f9fc">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Agreement Owner</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.Agreement__r.Owner.Name}</td>
            </tr>
            <tr bgcolor="#ffffff">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Kind</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.Kind__c}</td>
            </tr>
            <tr bgcolor="#f7f9fc">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">Start Date</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.StartDate__c}</td>
            </tr>
            <tr bgcolor="#ffffff">
              <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #eef1f6;">End Date</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #eef1f6;">{!relatedTo.EndDate__c}</td>
            </tr>
            <tr bgcolor="#f7f9fc">
              <td style="padding:12px 16px;font-size:13px;color:#718096;">Automatic Grid Update</td>
              <td style="padding:12px 16px;font-size:13px;color:#1a202c;">{!relatedTo.AutomaticGridUpdate__c}</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr><td style="padding:0 32px 8px 32px;font-size:0;">&nbsp;</td></tr>
    </table>

    <!-- ───── THRESHOLD SECTION (conditional) ───── -->
    <apex:outputPanel layout="block" rendered="{!NOT(ISBLANK(relatedTo.ThresholdAmount__c))}">
      <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
        <tr>
          <td style="padding:16px 32px 0 32px;">
            <p style="margin:0 0 10px 0;font-size:11px;font-weight:700;color:#b7791f;text-transform:uppercase;letter-spacing:2px;">Threshold Information</p>
            <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #f6e05e;border-radius:6px;overflow:hidden;">
              <tr bgcolor="#fffff0">
                <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #fefcbf;width:38%;">Threshold Amount</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;font-weight:600;border-bottom:1px solid #fefcbf;">{!relatedTo.ThresholdAmount__c}</td>
              </tr>
              <tr bgcolor="#fefce8">
                <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #fefcbf;">Threshold Currency</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #fefcbf;">{!relatedTo.ThresholdAmountCurrency__c}</td>
              </tr>
              <tr bgcolor="#fffff0">
                <td style="padding:12px 16px;font-size:13px;color:#718096;">Threshold Mode</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;">{!relatedTo.ThresholdMode__c}</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr><td style="padding:0 32px 8px 32px;font-size:0;">&nbsp;</td></tr>
      </table>
    </apex:outputPanel>

    <!-- ───── MINIMUM SECTION (conditional) ───── -->
    <apex:outputPanel layout="block" rendered="{!NOT(ISBLANK(relatedTo.MinimumAmount__c))}">
      <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
        <tr>
          <td style="padding:16px 32px 0 32px;">
            <p style="margin:0 0 10px 0;font-size:11px;font-weight:700;color:#276749;text-transform:uppercase;letter-spacing:2px;">Minimum Information</p>
            <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #9ae6b4;border-radius:6px;overflow:hidden;">
              <tr bgcolor="#f0fff4">
                <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #c6f6d5;width:38%;">Minimum Amount</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;font-weight:600;border-bottom:1px solid #c6f6d5;">{!relatedTo.MinimumAmount__c}</td>
              </tr>
              <tr bgcolor="#f7fff9">
                <td style="padding:12px 16px;font-size:13px;color:#718096;border-bottom:1px solid #c6f6d5;">Minimum Currency</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;border-bottom:1px solid #c6f6d5;">{!relatedTo.MinimumAmountCurrency__c}</td>
              </tr>
              <tr bgcolor="#f0fff4">
                <td style="padding:12px 16px;font-size:13px;color:#718096;">Minimum Frequency</td>
                <td style="padding:12px 16px;font-size:13px;color:#1a202c;">{!relatedTo.MinimumAmountFrequency__c}</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr><td style="padding:0 32px 8px 32px;font-size:0;">&nbsp;</td></tr>
      </table>
    </apex:outputPanel>

    <!-- ───── VIEW AND COMPARE BUTTON ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
      <tr>
        <td style="padding:24px 32px;text-align:center;border-top:2px solid #e8edf3;">
          <a href="{!relatedTo.Link}" style="display:inline-block;background-color:#1b3a5c;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;padding:13px 36px;border-radius:6px;letter-spacing:0.5px;">View and Compare &#8594;</a>
        </td>
      </tr>
    </table>

    <!-- ───── DRAFT ACTION BUTTONS ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
      <tr>
        <td style="padding:0 32px 28px 32px;border-top:1px solid #eef1f6;">
          <p style="margin:16px 0 14px 0;font-size:12px;color:#a0aec0;text-align:center;font-style:italic;">Quick actions &mdash; coming soon</p>
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td width="50%" align="right" style="padding-right:8px;">
                <span style="display:inline-block;background-color:#c6f6d5;color:#22543d;font-size:14px;font-weight:700;padding:12px 36px;border-radius:6px;opacity:0.6;cursor:default;">&#10003; Approve</span>
              </td>
              <td width="50%" align="left" style="padding-left:8px;">
                <span style="display:inline-block;background-color:#fed7d7;color:#742a2a;font-size:14px;font-weight:700;padding:12px 36px;border-radius:6px;opacity:0.6;cursor:default;">&#10007; Reject</span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>

    <!-- ───── FOOTER ───── -->
    <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f7f9fc" style="border-radius:0 0 8px 8px;border-top:1px solid #e2e8f0;">
      <tr>
        <td style="padding:16px 32px;text-align:center;">
          <p style="margin:0;font-size:11px;color:#a0aec0;">This is an automated notification &mdash; please do not reply to this email.</p>
        </td>
      </tr>
    </table>

  </td></tr>
  </table>

</td></tr>
</table>

</body>
</html>
</messaging:htmlEmailBody>

<messaging:plainTextEmailBody>
====================================
  GRID AMENDMENT - APPROVAL REQUEST
====================================

Hello,

A Grid Amendment has been submitted and is pending your approval.
Please review the details below and take action.

GRID DETAILS
------------------------------------
Agreement Name:        {!relatedTo.Agreement__r.Name}
Company Name:          {!relatedTo.Agreement__r.Company_Name__c}
Team:                  {!relatedTo.Agreement__r.Team__c}
Agreement Owner:       {!relatedTo.Agreement__r.Owner.Name}
Kind:                  {!relatedTo.Kind__c}
Start Date:            {!relatedTo.StartDate__c}
End Date:              {!relatedTo.EndDate__c}
Automatic Grid Update: {!relatedTo.AutomaticGridUpdate__c}

View and Compare: {!relatedTo.Link}

This is an automated notification - please do not reply to this email.
</messaging:plainTextEmailBody>

</messaging:emailTemplate>
