<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style=""><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello,</p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p class="isSelectedEnd">A new picture for the Product Manager&nbsp;<span style="background-color: rgb(255, 255, 255); font-size: 12pt;">{!FundManager__c.FirstName__c} {!FundManager__c.LastName__c}&nbsp;</span><span style="font-size: 12pt;">has been added in Salesforce.&nbsp;</span></p><p class="isSelectedEnd"><span style="font-size: 12pt;"><br></span></p><p class="isSelectedEnd" style="background-color: rgb(255, 255, 255);"><font face="arial" style="font-size: 12pt;">You can access the Product Manager record using the link below:&nbsp;</font><font face="arial">{!FundManager__c.RecordLink__c}</font></p><p class="isSelectedEnd" style="font-size: 12pt; background-color: rgb(255, 255, 255);"><br></p><p style="font-size: 12pt; background-color: rgb(255, 255, 255);">Best regards,</p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div></div></div>]]></td>
