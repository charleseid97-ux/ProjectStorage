<![CDATA[<div style=""><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello,</p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p class="isSelectedEnd" style=""><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">The Product Manager</span><font face="arial"><span style="font-size: 12pt;">&nbsp;</span>{!FundManagerAssignment__c.PortfolioManagerFullName__c}<span style="font-size: 12pt;">&nbsp;has been added to the product&nbsp;</span>{!FundManagerAssignment__c.ProductName__c}</font><span style="font-family: arial; font-size: 12pt;">. Please find the details below:</span></p><ul data-spread="false" style=""><li style=""><strong style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Rep Order:</strong><font face="arial"><span style="font-size: 12pt;">&nbsp;</span>{!FundManagerAssignment__c.RepOrder__c}</font></li><li style=""><strong style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Start Date:</strong><font face="arial"><span style="font-size: 12pt;">&nbsp;</span>{!FundManagerAssignment__c.StartDate__c}</font></li><li style=""><strong style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">End Date:</strong><font face="arial"><span style="font-size: 12pt;">&nbsp;</span>{!FundManagerAssignment__c.EndDate__c}</font></li></ul><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Best regards,</p></div>]]></td>
