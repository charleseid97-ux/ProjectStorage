<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style=""><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello,</p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p class="isSelectedEnd">A new Product Manager&nbsp;<span style="background-color: rgb(255, 255, 255); font-size: 12pt;">{!FundManager__c.FirstName__c} {!FundManager__c.LastName__c}&nbsp;</span><span style="font-size: 12pt;">has been created in Salesforce.&nbsp;</span></p><p class="isSelectedEnd"><span style="font-size: 12pt;"><br></span></p><p class="isSelectedEnd" style="">Kindly send the picture to <strong>Salesforce Support</strong>&nbsp;<span style="font-size: 12pt;">at </span><a href="mailto:salesforcesupport@carmignac.com" style="font-size: 12pt;">salesforcesupport@carmignac.com</a><span style="font-size: 12pt;"> so they can upload it to the record.</span></p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Thank you</span>,</p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div></div></div>]]></td>
