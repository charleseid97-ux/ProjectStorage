<![CDATA[<div style=""><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hello,</p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">The Biography for the Product Manager {!Narrative__c.FundManagerName__c} has been updated. Please find the details below:</p><ul data-spread="false" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><li><strong>Language:</strong>&nbsp;{!Narrative__c.Language__c}</li><li><strong>Biography Content:</strong> {!Narrative__c.Content__c}</li></ul><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></font><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">You can access the Biography record using the link below:&nbsp;</span></font><font face="arial">{!Narrative__c.NarrativeLink__c}</font><br><p class="isSelectedEnd" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Best regards,</p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div></div></div>]]></td>
