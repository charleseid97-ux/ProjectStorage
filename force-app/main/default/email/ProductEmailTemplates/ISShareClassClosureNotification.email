<html>
<head>
	<title></title>
</head>
<body style="height: auto; min-height: auto;">
<table border="0" cellpadding="0" cellspacing="0" style="font-family:Arial,Helvetica,sans-serif;background-color:#FAF1F2;padding:24px;" width="100%">
	
		<tr>
			<td align="center">
			<table border="0" cellpadding="0" cellspacing="0" style="width:620px;max-width:100%;background-color:#ffffff;border:1px solid #E8D6D9;" width="620">
				
					<tr>
						<td style="background-color:#7A1E2B;height:10px;font-size:0;line-height:0;">&nbsp;</td>
					</tr>
					<tr>
						<td style="padding:28px 28px 16px 28px;color:#242424;font-size:14px;line-height:22px;">Hello,<br />
						<br />
						The following Share Class has been <strong>closed</strong>:</td>
					</tr>
					<tr>
						<td style="padding:4px 28px 24px 28px;">
						<table border="0" cellpadding="0" cellspacing="0" style="background-color:#FAF1F2;border-left:4px solid #B33A4A;" width="100%">
							
								<tr>
									<td style="padding:18px 20px;color:#242424;font-size:14px;line-height:22px;">The Share Class is no longer active in Salesforce.</td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="background-color:#7A1E2B;padding:16px 28px;">
						<div style="font-size:15px;font-weight:bold;letter-spacing:0.5px;color:#ffffff;">SHARE CLASS INFORMATION</div>
						</td>
					</tr>
					<tr>
						<td style="padding:16px 28px 24px 28px;">
						<table border="0" cellpadding="0" cellspacing="0" style="font-size:14px;color:#242424;" width="100%">
							
								<tr>
									<td style="padding:13px 10px 13px 0;border-bottom:1px solid #E8D6D9;color:#6B5B60;font-weight:bold;" valign="top" width="185">Product:</td>
									<td style="padding:13px 0;border-bottom:1px solid #E8D6D9;line-height:21px;" valign="top">{{{Share_Class__c.ProductShortName__c}}}</td>
								</tr>
								<tr>
									<td style="padding:13px 10px 13px 0;border-bottom:1px solid #E8D6D9;color:#6B5B60;font-weight:bold;" valign="top">Share Class:</td>
									<td style="padding:13px 0;border-bottom:1px solid #E8D6D9;line-height:21px;" valign="top"><a href="{{{Share_Class__c.Link}}}" rel="noopener noreferrer" style="color:#7A1E2B;font-weight:bold;text-decoration:underline;">{{{Share_Class__c.Name}}} </a></td>
								</tr>
								<tr>
									<td style="padding:13px 10px 13px 0;border-bottom:1px solid #E8D6D9;color:#6B5B60;font-weight:bold;" valign="top">ISIN:</td>
									<td style="padding:13px 0;border-bottom:1px solid #E8D6D9;line-height:21px;" valign="top"><strong>{{{Share_Class__c.ISIN__c}}}</strong></td>
								</tr>
								<tr>
									<td style="padding:13px 10px 13px 0;border-bottom:1px solid #E8D6D9;color:#6B5B60;font-weight:bold;" valign="top">Closure Type:</td>
									<td style="padding:13px 0;border-bottom:1px solid #E8D6D9;line-height:21px;" valign="top">{{{Share_Class__c.Status__c}}}</td>
								</tr>
								<tr>
									<td style="padding:13px 10px 13px 0;color:#6B5B60;font-weight:bold;" valign="top">Closure Date:</td>
									<td style="padding:13px 0;font-weight:bold;color:#7A1E2B;" valign="top">{{{Share_Class__c.CloseDate__c}}}</td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="padding:4px 28px 30px 28px;">
						<table border="0" cellpadding="0" cellspacing="0">
							
								<tr>
									<td bgcolor="#7A1E2B" style="background-color:#7A1E2B;"><a href="{{{Share_Class__c.Link}}}" rel="noopener noreferrer" style="display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:13px;font-weight:bold;">VIEW SHARE CLASS IN SALESFORCE </a></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="border-top:1px solid #E8D6D9;padding:20px 28px 24px 28px;color:#6B5B60;font-size:13px;line-height:21px;">Best regards,</td>
					</tr>
				
			</table>
			</td>
		</tr>
	
</table>
</body>
</html>