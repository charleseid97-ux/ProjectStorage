<html>
<head>
	<title></title>
</head>
<body style="height: auto; min-height: auto;">
<table border="0" cellpadding="0" cellspacing="0" style="font-family:Arial,Helvetica,sans-serif;background:#f5f7f5;padding:24px;" width="100%">
	
		<tr>
			<td align="center">
			<table border="0" cellpadding="0" cellspacing="0" style="width:620px;max-width:100%;background:#ffffff;border:1px solid #e2e6e2;" width="620">
				
					<tr>
						<td style="background:#2f4233;padding:22px 28px;">
						<div style="font-size:12px;letter-spacing:1px;color:#cbd8ce;font-weight:bold;">AI AGENT GOVERNANCE</div>

						<div style="font-size:22px;line-height:28px;color:#ffffff;font-weight:bold;margin-top:4px;">New Agent Request</div>
						</td>
					</tr>
					<tr>
						<td style="padding:26px 28px 14px 28px;color:#242424;font-size:14px;line-height:21px;">Hello,<br />
						<br />
						A new AI Agent request has been submitted and is ready for review.</td>
					</tr>
					<tr>
						<td style="padding:6px 28px 22px 28px;">
						<table border="0" cellpadding="0" cellspacing="0" style="font-size:14px;color:#242424;" width="100%">
							
								<tr>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;color:#6b746d;font-weight:bold;" width="160">Agent</td>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;">{{{Case.AgentName__c}}}</td>
								</tr>
								<tr>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;color:#6b746d;font-weight:bold;">Category</td>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;">{{{Case.UseCaseCategory__c}}}</td>
								</tr>
								<tr>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;color:#6b746d;font-weight:bold;">Purpose</td>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;">{{{Case.AgentPurpose__c}}}</td>
								</tr>
								<tr>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;color:#6b746d;font-weight:bold;">Data &amp; Connectors</td>
									<td style="padding:10px 0;border-bottom:1px solid #eeeeee;">{{{Case.Connectors__c}}}</td>
								</tr>
								<tr>
									<td style="padding:10px 0;color:#6b746d;font-weight:bold;">Usage Mode</td>
									<td style="padding:10px 0;">{{{Case.UsageMode__c}}}</td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="background:#f1f5f2;padding:20px 28px;color:#242424;font-size:14px;line-height:21px;"><strong style="color:#2f4233;">Next step</strong><br />
						Review the request and contact the builder to organise a short review meeting.</td>
					</tr>
					<tr>
						<td style="padding:24px 28px 28px 28px;">
						<table border="0" cellpadding="0" cellspacing="0">
							
								<tr>
									<td style="background:#2f4233;"><a href="{{{Case.link}}}" style="display:inline-block;padding:12px 20px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;">Open Agent Request </a></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="border-top:1px solid #eeeeee;padding:16px 28px;color:#777777;font-size:12px;line-height:18px;">Dust Admin Team<br />
						Carmignac AI Agent Governance</td>
					</tr>
				
			</table>
			</td>
		</tr>
	
</table>
</body>
</html>