<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF (Campaign.NumberOfDelivered__c:SUM=0,0,Campaign.NumberOfOpen__c:SUM / Campaign.NumberOfDelivered__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Open Rate</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(
    Campaign.NumberOfDelivered__c:SUM = 0,
    0,
    Campaign.NumberOfClicks__c:SUM / Campaign.NumberOfDelivered__c:SUM
)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Click-Through Rate</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF(
    Campaign.NumberOfOpen__c:SUM = 0,
    0,
    Campaign.NumberOfClicks__c:SUM / Campaign.NumberOfOpen__c:SUM
)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA3</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Click-To-Open Rate</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>IF (Campaign.NumberOfDelivered__c:SUM=0,0,Campaign.NumberOfDelivered__c:SUM / Campaign.NumberOfSent__c:SUM)</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA4</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Delivered Rate</masterLabel>
        <scale>0</scale>
    </aggregates>
    <chart>
