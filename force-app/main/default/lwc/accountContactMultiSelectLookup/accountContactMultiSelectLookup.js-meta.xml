<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Account Contact Multi Select Lookup</masterLabel>
    <description>Flow screen component: Account picker on top, Contact multi-select below. Outputs selected Contact Ids and Account Id.</description>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="accountLabel" type="String" role="inputOnly" label="Account Label"/>
            <property name="picklistLabel" type="String" role="inputOnly" label="Contacts Label"/>
            <property name="limitSize" type="Integer" role="inputOnly" label="Max contacts loaded (default 200)"/>
            <property name="preselectedAccountId" type="String" role="inputOnly" label="Preselected Account Id"/>
            <property name="preselectedIdsJson" type="String" role="inputOnly" label="Preselected Contact Ids (JSON array string)"/>
            <property name="showAddress" type="Boolean" role="inputOnly" label="Display Address"/>

            <property name="accountId" type="String" role="outputOnly" label="Selected Account Id"/>
            <property name="selectedIdsJson" type="String" role="outputOnly" label="Selected Contact Ids (JSON array string)"/>
            <property name="selectedIdsCsv" type="String" role="outputOnly" label="Selected Contact Ids (CSV)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>