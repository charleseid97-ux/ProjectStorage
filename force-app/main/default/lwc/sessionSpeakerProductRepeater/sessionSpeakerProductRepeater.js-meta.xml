<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Session Speaker Product Repeater</masterLabel>
    <description>Flow screen component: Speaker (picker), Products (custom multi-select), Language (picklist or text).</description>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="debug"
                      type="Boolean"
                      role="inputOnly"
                      label="Enable inline debug panel"/>

            <property name="parentEventId"
                      type="String"
                      role="inputOnly"
                      label="Parent Event Id (preselect speaker)"/>

            <property name="showTimeSlots"
                      type="Boolean"
                      role="inputOnly"
                      label="Show Start and End Time"/>

            <property name="defaultStartTime"
                      type="String"
                      role="inputOnly"
                      label="Default Start Time"/>

            <property name="defaultEndTime"
                      type="String"
                      role="inputOnly"
                      label="Default End Time"/>

            <property name="outputValue"
                      type="String"
                      role="outputOnly"
                      label="Records JSON (sessionSpeakerProduct__c list)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>