<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Operation Log Viewer</masterLabel>
    <description>Displays OperationLog__c records linked to the current record by SourceRecordId__c.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" label="Titre" default="Technical logs" />
            <property name="defaultLimit" type="Integer" label="Number of logs" default="50" />
            <property name="defaultLevel" type="String" label="Minimum level" default="DEBUG" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
